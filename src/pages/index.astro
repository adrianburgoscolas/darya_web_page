---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import ValueProps from "../components/ValueProps.astro";
import ProductShowcase from "../components/ProductShowcase.astro";
import HowItWorks from "../components/HowItWorks.astro";
import TrustSocial from "../components/TrustSocial.astro";
import FAQ from "../components/FAQ.astro";

const {
  site,
  url,
} = Astro;
const canonicalUrl = new URL(url.pathname, site).href;
const orgJsonLd = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "Darya Integral Trade SL",
  url: canonicalUrl,
  logo: new URL("/darya_logo.png", site).href,
  image: new URL("/og-image.png", site).href,
  description:
    "Darya Integral Trade SL — Electrodomésticos, accesorios del hogar y materiales de construcción con puntos de recogida en Latinoamérica.",
  areaServed: [
    "México",
    "Colombia",
    "Brasil",
    "Argentina",
    "Chile",
    "Perú",
    "Ecuador",
    "Guatemala",
  ],
  contactPoint: {
    "@type": "ContactPoint",
    contactType: "customer service",
    url: new URL("/contacto", site).href,
    availableLanguage: "Spanish",
  },
};

const webSiteJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "Darya Integral Trade SL",
  url: canonicalUrl,
  inLanguage: "es",
  description:
    "Todo para tu hogar. Electrodomésticos, accesorios y materiales de construcción con puntos de recogida en toda Latinoamérica.",
  publisher: {
    "@type": "Organization",
    name: "Darya Integral Trade SL",
  },
};
---

<Layout
  title="Darya Integral Trade SL — Todo para tu hogar, al alcance de tu mano."
  description="Darya Integral Trade SL - Todo para tu hogar. Electrodomésticos, accesorios y materiales de construcción con puntos de recogida en toda Latinoamérica."
  ogTitle="Darya Integral Trade SL — Todo para tu hogar"
  ogDescription="Electrodomésticos, accesorios y materiales de construcción con puntos de recogida en toda Latinoamérica."
>
  <script type="application/ld+json" set:html={JSON.stringify(orgJsonLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(webSiteJsonLd)} />
  <main>
    <Hero />
    <ValueProps />
    <ProductShowcase />
    <HowItWorks />
    <TrustSocial />
    <FAQ />
  </main>
</Layout>
