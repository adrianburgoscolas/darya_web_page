---
import { Mail } from "@lucide/astro";
import { withBase } from "../utils/paths";
---
<footer class="relative bg-white border-t border-slate-200/70">
  <div class="h-1 w-full bg-gradient-to-r from-gold via-emerald to-sky-500" aria-hidden="true"></div>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14 lg:py-20">
    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-10 lg:gap-12">
      <!-- Brand -->
      <div class="sm:col-span-2 lg:col-span-1">
        <a href={withBase("/")} class="inline-flex items-center gap-3 mb-4 group">
          <img src={withBase("/darya_logo.png")} alt="Darya Integral Trade SL" class="h-9 w-auto transition-transform duration-300 group-hover:scale-105" />
          <div>
            <span class="block text-lg font-extrabold text-navy leading-tight">Darya</span>
            <span class="block text-[11px] font-semibold text-slate-400 tracking-widest uppercase">Integral Trade SL</span>
          </div>
        </a>
        <p class="text-gold font-bold text-sm leading-relaxed mb-3">
          Puente entre clientes a nuestro alcance y sus objetivos en Latinoamérica.
        </p>
        <p class="text-slate-500 text-sm leading-relaxed mb-6">
          Todo para tu hogar en un solo lugar. Electrodomésticos, accesorios y materiales de construcción con puntos de recogida en toda Latinoamérica. Servicio profesional para países hispanoamericanos.
        </p>
      </div>

      <!-- Quick links -->
      <div>
        <h4 class="text-navy font-extrabold mb-5">Enlaces Rápidos</h4>
        <ul class="space-y-3">
          {[
            { href: withBase("/#catalogo"), label: "Categorías" },
            { href: withBase("/#como-funciona"), label: "¿Cómo Funciona?" },
            { href: withBase("/#opiniones"), label: "Opiniones" },
            { href: withBase("/contacto"), label: "Contacto" },
          ].map((link) => (
            <li>
              <a href={link.href} class="text-slate-500 hover:text-gold text-sm transition-colors">{link.label}</a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Help -->
      <div>
        <h4 class="text-navy font-extrabold mb-5">Ayuda</h4>
        <ul class="space-y-3">
          {[
            { href: withBase("/#garantia"), label: "Garantía y Devoluciones" },
            { href: withBase("/terminos"), label: "Términos y Condiciones" },
            { href: withBase("/privacidad"), label: "Aviso de Privacidad" },
            { href: withBase("/cookies"), label: "Política de Cookies" },
          ].map((link) => (
            <li>
              <a href={link.href} class="text-slate-500 hover:text-gold text-sm transition-colors">{link.label}</a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Contact -->
      <div>
        <h4 class="text-navy font-extrabold mb-5">Contacto</h4>
        <ul class="space-y-3">
          <li class="flex items-start gap-3">
            <span class="inline-flex items-center justify-center w-9 h-9 rounded-xl bg-gradient-to-br from-gold to-gold-light text-white shadow-lg shadow-gold/25 shrink-0">
              <Mail class="size-4" />
            </span>
            <a href={withBase("/contacto")} class="text-slate-500 hover:text-gold text-sm transition-colors pt-2">Formulario de contacto</a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="mt-12 pt-8 border-t border-slate-200/70 flex flex-col sm:flex-row items-center justify-between gap-4">
      <p class="text-slate-400 text-sm">
        &copy; {new Date().getFullYear()} Darya Integral Trade SL. Todos los derechos reservados.
      </p>
      <div class="flex gap-6">
        <a href={withBase("/privacidad")} class="text-slate-400 hover:text-gold text-sm transition-colors">Privacidad</a>
        <a href={withBase("/terminos")} class="text-slate-400 hover:text-gold text-sm transition-colors">Términos</a>
        <a href={withBase("/cookies")} class="text-slate-400 hover:text-gold text-sm transition-colors">Cookies</a>
      </div>
    </div>
  </div>
</footer>
