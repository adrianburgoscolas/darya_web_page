---
import { MapPin, Mail } from "@lucide/astro";
---
<footer class="bg-navy border-t border-white/5">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 lg:py-16">
    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-8 lg:gap-12">
      <!-- Brand -->
      <div class="sm:col-span-2 lg:col-span-1">
        <a href="/" class="inline-flex items-center gap-3 mb-4">
          <img src="/darya_logo.png" alt="Darya Integral Trade SL" class="h-8 w-auto" />
          <div>
            <span class="block text-lg font-bold text-white leading-tight">Darya</span>
            <span class="block text-xs text-slate-500">Integral Trade SL</span>
          </div>
        </a>
        <p class="text-slate-400 text-sm leading-relaxed mb-6">
          Todo para tu hogar en un solo lugar. Electrodomésticos, accesorios y materiales de construcción con envíos a toda Latinoamérica.
        </p>
        <!-- Social links -->
        <div class="flex gap-3">
          {["Facebook", "Instagram", "Twitter", "YouTube"].map((social) => (
            <a
              href="#"
              class="w-9 h-9 rounded-full bg-white/5 flex items-center justify-center text-slate-400 hover:bg-gold hover:text-white transition-all duration-200"
              aria-label={social}
            >
              <span class="text-xs font-bold">{social[0]}</span>
            </a>
          ))}
        </div>
      </div>

      <!-- Quick links -->
      <div>
        <h4 class="text-white font-semibold mb-4">Enlaces Rápidos</h4>
        <ul class="space-y-2.5">
          {["Categorías", "¿Cómo Funciona?", "Opiniones", "Contacto"].map((link) => (
            <li>
              <a href="#" class="text-slate-400 hover:text-white text-sm transition-colors">{link}</a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Help -->
      <div>
        <h4 class="text-white font-semibold mb-4">Ayuda</h4>
        <ul class="space-y-2.5">
          {["Centro de Ayuda", "Garantía y Devoluciones", "Política de Envíos", "Términos y Condiciones", "Aviso de Privacidad"].map((link) => (
            <li>
              <a href="#" class="text-slate-400 hover:text-white text-sm transition-colors">{link}</a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Contact -->
      <div>
        <h4 class="text-white font-semibold mb-4">Contacto</h4>
        <ul class="space-y-3">
          <li class="flex items-start gap-3">
            <MapPin class="size-5 text-gold-light shrink-0 mt-0.5" />
            <span class="text-slate-400 text-sm">MADRID CALLE FRANCISCO NAVACERRADA 2, ES</span>
          </li>
          <li class="flex items-start gap-3">
            <Mail class="size-5 text-gold-light shrink-0 mt-0.5" />
            <a href="/contacto" class="text-slate-400 hover:text-white text-sm transition-colors">Formulario de contacto</a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="mt-12 pt-8 border-t border-white/5 flex flex-col sm:flex-row items-center justify-between gap-4">
      <p class="text-slate-500 text-sm">
        &copy; {new Date().getFullYear()} Darya Integral Trade SL. Todos los derechos reservados.
      </p>
      <div class="flex gap-6">
        <a href="#" class="text-slate-500 hover:text-slate-300 text-sm transition-colors">Privacidad</a>
        <a href="#" class="text-slate-500 hover:text-slate-300 text-sm transition-colors">Términos</a>
        <a href="#" class="text-slate-500 hover:text-slate-300 text-sm transition-colors">Cookies</a>
      </div>
    </div>
  </div>
</footer>
