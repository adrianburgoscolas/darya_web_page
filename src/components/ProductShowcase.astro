---
import { WashingMachine, LampCeiling, Hammer } from "@lucide/astro";
import { withBase } from "../utils/paths";
---
<section id="catalogo" class="relative overflow-hidden bg-slate-50 py-20 lg:py-28">
  <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[800px] h-[400px] bg-gradient-to-b from-white to-transparent rounded-full blur-3xl"></div>
  </div>

  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-2xl mx-auto mb-16">
      <span class="inline-flex items-center gap-2 text-gold font-bold text-sm uppercase tracking-widest">
        <span class="w-6 h-px bg-gradient-to-r from-transparent to-gold"></span>
        Nuestras Categorías
        <span class="w-6 h-px bg-gradient-to-l from-transparent to-gold"></span>
      </span>
      <h2 class="mt-5 text-3xl sm:text-4xl lg:text-5xl font-extrabold text-navy tracking-tight">
        Todo lo que necesitas
        <span class="bg-gradient-to-r from-gold to-gold-light bg-clip-text text-transparent">para tu hogar</span>
      </h2>
      <p class="mt-5 text-lg text-slate-500">
        Explora nuestras líneas de productos. Electrodomésticos, accesorios y materiales de construcción de calidad.
      </p>
    </div>

    <!-- Category cards -->
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
      {[
        {
          cat: "Electrodomésticos",
          desc: "Equipa tu hogar con lavadoras, neveras, cocinas, microondas, aires acondicionados y más.",
          Icon: WashingMachine,
          highlight: true,
          iconBg: "bg-gradient-to-br from-amber-400 to-gold",
          blob: "bg-gold/20",
          subitems: ["Lavadoras y secadoras", "Neveras y congeladores", "Cocinas y hornos", "Microondas", "Aires acondicionados"],
        },
        {
          cat: "Accesorios del Hogar",
          desc: "Iluminación, decoración, menaje de cocina, muebles auxiliares y todo para embellecer tu espacio.",
          Icon: LampCeiling,
          highlight: false,
          iconBg: "bg-gradient-to-br from-sky-400 to-blue-600",
          blob: "bg-sky-100",
          subitems: ["Lámparas e iluminación LED", "Menaje y utensilios de cocina", "Decoración y textiles", "Muebles auxiliares", "Organizadores y almacenaje"],
        },
        {
          cat: "Materiales de Construcción",
          desc: "Herramientas eléctricas, ferretería, pinturas, acabados y todo lo necesario para construir y renovar.",
          Icon: Hammer,
          highlight: false,
          iconBg: "bg-gradient-to-br from-emerald to-emerald/80",
          blob: "bg-emerald-100",
          subitems: ["Herramientas eléctricas y manuales", "Ferretería y tornillería", "Pinturas y recubrimientos", "Pisos y revestimientos", "Plomería y electricidad"],
        },
      ].map((category) => (
        <div
          class={`group relative overflow-hidden rounded-[1.75rem] shadow-xl shadow-slate-200/70 transition-all duration-300 hover:-translate-y-2 hover:shadow-2xl ${
            category.highlight
              ? "bg-gradient-to-br from-navy via-navy-light to-navy shadow-navy/30"
              : "bg-white ring-1 ring-slate-100 hover:ring-gold/40"
          }`}
        >
          <div class={`absolute -top-16 -right-16 w-48 h-48 ${category.highlight ? category.blob : category.blob} rounded-full blur-3xl opacity-70`} aria-hidden="true"></div>

          <div class="relative p-7 sm:p-8">
            <div class={`inline-flex items-center justify-center w-16 h-16 rounded-2xl ${category.iconBg} shadow-lg mb-6 transition-transform duration-300 group-hover:scale-110 group-hover:-rotate-3`}>
              <category.Icon class="size-8 text-white" />
            </div>
            <h3 class={`text-xl font-extrabold mb-3 ${category.highlight ? "text-white" : "text-navy"}`}>
              {category.cat}
            </h3>
            <p class={`text-sm leading-relaxed mb-6 ${category.highlight ? "text-slate-300" : "text-slate-500"}`}>
              {category.desc}
            </p>
            <ul class="space-y-2.5">
              {category.subitems.map((item) => (
                <li class={`flex items-center gap-2.5 text-sm ${category.highlight ? "text-slate-300" : "text-slate-500"}`}>
                  <span class={`w-1.5 h-1.5 rounded-full shrink-0 ${category.highlight ? "bg-gold-light" : "bg-gold"}`}></span>
                  {item}
                </li>
              ))}
            </ul>
          </div>
          <div class={`relative px-7 sm:px-8 py-4 border-t ${category.highlight ? "border-white/10" : "border-slate-100"}`}>
            <a
              href={withBase("/contacto")}
              class={`inline-flex items-center gap-2 text-sm font-bold transition-colors ${
                category.highlight ? "text-gold-light hover:text-white" : "text-gold hover:text-navy"
              }`}
            >
              Solicitar información
              <svg xmlns="http://www.w3.org/2000/svg" class="size-4 transition-transform duration-300 group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </a>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
