---
import { Menu } from "@lucide/astro";
import { withBase } from "../utils/paths";

const navLinks = [
  { href: withBase("/#catalogo"), label: "Categorías" },
  { href: withBase("/#como-funciona"), label: "¿Cómo Funciona?" },
  { href: withBase("/#garantia"), label: "Garantía & Entregas" },
  { href: withBase("/#opiniones"), label: "Opiniones" },
  { href: withBase("/contacto"), label: "Contacto" },
];
---

<header class="fixed top-0 left-0 right-0 z-50 bg-white/80 backdrop-blur-xl border-b border-slate-200/60">
  <nav class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16 lg:h-20">
      <!-- Logo -->
      <a href={withBase("/")} class="flex items-center gap-3 shrink-0 group">
        <img
          src={withBase("/darya_logo.png")}
          alt="Darya Integral Trade SL"
          class="h-9 sm:h-11 w-auto drop-shadow-sm transition-transform duration-300 group-hover:scale-105"
        />
        <span class="hidden sm:block text-sm font-extrabold text-navy leading-tight tracking-tight">
          Darya<br /><span class="text-[11px] font-semibold text-slate-400 tracking-widest uppercase">Integral Trade SL</span>
        </span>
      </a>

      <!-- Desktop nav -->
      <div class="hidden lg:flex items-center gap-9">
        {navLinks.map((link) => (
          <a
            href={link.href}
            class="text-sm font-semibold text-slate-600 hover:text-navy transition-colors duration-200 relative after:absolute after:left-0 after:-bottom-1 after:h-0.5 after:w-0 after:bg-gradient-to-r after:from-gold after:to-gold-light after:rounded-full after:transition-all after:duration-300 hover:after:w-full"
          >
            {link.label}
          </a>
        ))}
      </div>

      <!-- CTA + Mobile toggle -->
      <div class="flex items-center gap-3">
        <a
          href={withBase("/contacto")}
          class="hidden sm:inline-flex items-center px-6 py-2.5 bg-gradient-to-r from-gold to-gold-light text-white text-sm font-bold rounded-full hover:from-gold-light hover:to-gold transition-all duration-300 shadow-lg shadow-gold/25 hover:shadow-xl hover:shadow-gold/30 hover:-translate-y-0.5"
        >
          Solicitar Info
        </a>
        <!-- Mobile hamburger -->
        <button
          id="mobile-menu-btn"
          class="lg:hidden text-navy p-2 hover:bg-slate-100 rounded-xl transition-colors"
          aria-label="Abrir menú"
        >
          <Menu class="size-6" />
        </button>
      </div>
    </div>

    <!-- Mobile menu -->
    <div id="mobile-menu" class="hidden lg:hidden pb-4 border-t border-slate-200/60 mt-2 pt-4">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class="block py-3 text-base font-semibold text-slate-600 hover:text-navy transition-colors"
        >
          {link.label}
        </a>
      ))}
      <a
        href={withBase("/contacto")}
        class="mt-3 inline-flex w-full justify-center items-center px-5 py-3 bg-gradient-to-r from-gold to-gold-light text-white text-sm font-bold rounded-full hover:from-gold-light hover:to-gold transition-all duration-200"
      >
        Solicitar Info
      </a>
    </div>
  </nav>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => {
    menu?.classList.toggle('hidden');
  });
  // Close menu on link click
  menu?.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', () => menu.classList.add('hidden'));
  });
</script>
