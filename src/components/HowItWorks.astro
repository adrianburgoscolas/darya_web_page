---
import { Search, MessageSquareText, MapPin } from "@lucide/astro";
---
<section id="como-funciona" class="relative overflow-hidden bg-gradient-to-b from-white via-amber-50/30 to-white py-20 lg:py-28">
  <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
    <div class="absolute bottom-0 right-0 w-[500px] h-[500px] bg-gradient-to-tl from-emerald-50 to-transparent rounded-full blur-3xl"></div>
    <div class="absolute -top-24 -left-24 w-[450px] h-[450px] bg-gradient-to-br from-sky-100/50 to-transparent rounded-full blur-3xl"></div>
  </div>

  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-2xl mx-auto mb-16">
      <span class="inline-flex items-center gap-2 text-gold font-bold text-sm uppercase tracking-widest">
        <span class="w-6 h-px bg-gradient-to-r from-transparent to-gold"></span>
        ¿Cómo Funciona?
        <span class="w-6 h-px bg-gradient-to-l from-transparent to-gold"></span>
      </span>
      <h2 class="mt-5 text-3xl sm:text-4xl lg:text-5xl font-extrabold text-navy tracking-tight">
        Así de simple es <span class="bg-gradient-to-r from-gold via-rose-500 to-emerald bg-clip-text text-transparent">comprar con Darya</span>
      </h2>
      <p class="mt-5 text-lg text-slate-500">
        Tres pasos sencillos para equipar tu hogar con productos de calidad.
      </p>
    </div>

    <div class="relative">
      <div class="hidden lg:block absolute top-[4.5rem] left-[12%] right-[12%] h-1 rounded-full bg-gradient-to-r from-gold/40 via-sky-400/60 to-emerald/60"></div>

      <div class="grid lg:grid-cols-3 gap-8 lg:gap-12">
        {[
          {
            step: "01",
            title: "Explora nuestras categorías",
            desc: "Descubre nuestra selección de electrodomésticos, accesorios y materiales de construcción. Elige lo que necesitas para tu hogar.",
            Icon: Search,
            grad: "from-amber-400 to-gold",
            shadow: "shadow-gold/30",
            cardBg: "from-amber-50 via-white to-white",
            ring: "ring-amber-100 hover:ring-gold/50",
            blob: "bg-gold/20",
          },
          {
            step: "02",
            title: "Solicita información",
            desc: "Contáctanos para conocer condiciones, disponibilidad y acordar los términos que mejor se adapten a tus necesidades.",
            Icon: MessageSquareText,
            grad: "from-sky-400 to-blue-600",
            shadow: "shadow-blue-500/30",
            cardBg: "from-sky-50 via-white to-white",
            ring: "ring-sky-100 hover:ring-sky-400/50",
            blob: "bg-sky-300/40",
          },
          {
            step: "03",
            title: "Recoge en el punto de entrega",
            desc: "Tu pedido estará listo en el punto de recogida acordado según la gestión logística de tu país. Te notificamos cuándo puedes pasar a recogerlo.",
            Icon: MapPin,
            grad: "from-emerald to-emerald/80",
            shadow: "shadow-emerald/30",
            cardBg: "from-emerald-50 via-white to-white",
            ring: "ring-emerald-100 hover:ring-emerald/50",
            blob: "bg-emerald-200/50",
          },
        ].map((item) => (
          <div class="relative flex flex-col items-center text-center group">
            <div class={`relative z-10 flex items-center justify-center w-16 h-16 rounded-2xl bg-gradient-to-br ${item.grad} text-white font-black text-xl shadow-xl ${item.shadow} group-hover:scale-110 group-hover:-rotate-3 transition-transform duration-300`}>
              {item.step}
            </div>
            <div class={`relative mt-6 w-full overflow-hidden bg-gradient-to-b ${item.cardBg} rounded-[1.75rem] p-8 shadow-xl ${item.shadow} ring-1 ${item.ring} hover:shadow-2xl hover:-translate-y-1 transition-all duration-300`}>
              <div class={`absolute -top-14 -right-14 w-40 h-40 ${item.blob} rounded-full blur-3xl opacity-60 group-hover:opacity-100 transition-opacity duration-500`} aria-hidden="true"></div>
              <div class={`relative inline-flex items-center justify-center w-14 h-14 rounded-xl bg-gradient-to-br ${item.grad} text-white shadow-lg mb-5`}>
                <item.Icon class="size-7" />
              </div>
              <h3 class="relative text-xl font-extrabold text-navy mb-3">{item.title}</h3>
              <p class="relative text-slate-500 leading-relaxed text-sm">{item.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
