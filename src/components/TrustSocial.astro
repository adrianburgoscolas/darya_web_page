---
import { Lock, Shield, BadgeCheck, Headset, Package, Star, ChevronLeft, ChevronRight, Quote } from "@lucide/astro";

const testimonials = [
  {
    name: "María García",
    location: "México",
    text: "Compré todos los electrodomésticos para mi casa nueva con Darya. La calidad de los productos es excelente y el proceso fue completamente transparente. Me dieron total confianza desde el primer contacto.",
    rating: 5,
  },
  {
    name: "Carlos Rodríguez",
    location: "Colombia",
    text: "Lo que más valoro es la seriedad de la empresa. Me mantuvieron informado en cada etapa del proceso y mis productos estuvieron listos en el punto de recogida en perfecto estado. Sin duda volveré a comprar.",
    rating: 5,
  },
  {
    name: "Ana Silva",
    location: "Brasil",
    text: "Renové completamente mi cocina con Darya. La asesoría fue espectacular, me ayudaron a elegir los mejores productos según mi presupuesto. Las facilidades de pago hicieron todo más accesible.",
    rating: 5,
  },
  {
    name: "Pedro Martínez",
    location: "Argentina",
    text: "Compré materiales de construcción para remodelar mi casa. La calidad es superior a lo que encuentras localmente y a mejor precio. Empresa seria y comprometida con sus clientes.",
    rating: 5,
  },
  {
    name: "Laura Fernández",
    location: "Chile",
    text: "Excelente experiencia comprando accesorios para el hogar. La atención a través del formulario de contacto fue rapidísima y resolvieron todas mis dudas. Mis productos estuvieron listos en el punto de recogida antes de lo esperado.",
    rating: 5,
  },
  {
    name: "Diego López",
    location: "Perú",
    text: "Ya he hecho tres compras con Darya y siempre cumplen. La seguridad que transmiten es lo que más me gusta. Sabes que tu dinero está bien invertido y que recibirás exactamente lo que pediste.",
    rating: 5,
  },
  {
    name: "Sofía Ramírez",
    location: "Ecuador",
    text: "Amplié mi hogar con una nevera y una lavadora nuevas. Las condiciones de pago se adaptaron perfectamente a mis posibilidades. Recomiendo Darya a todos mis amigos y familiares.",
    rating: 5,
  },
  {
    name: "Ricardo Torres",
    location: "Guatemala",
    text: "La puntualidad con la que estuvieron listos mis productos en el punto de recogida y la calidad de los mismos me sorprendieron gratamente. Es difícil encontrar empresas tan profesionales y confiables. Darya superó mis expectativas.",
    rating: 4,
  },
];
---

<section id="opiniones" class="relative overflow-hidden bg-gradient-to-b from-white via-emerald-50/20 to-white py-20 lg:py-28">
  <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
    <div class="absolute top-0 left-0 w-[500px] h-[500px] bg-gradient-to-br from-amber-50 to-transparent rounded-full blur-3xl"></div>
    <div class="absolute bottom-0 right-0 w-[500px] h-[500px] bg-gradient-to-tl from-emerald-50 to-transparent rounded-full blur-3xl"></div>
    <div class="absolute top-1/3 right-1/4 w-[400px] h-[400px] bg-gradient-to-bl from-sky-100/50 to-transparent rounded-full blur-3xl"></div>
  </div>

  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Metrics counter -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6 mb-20">
      {[
        { value: "+50,000", label: "Clientes satisfechos", grad: "from-gold to-gold-light", cardBg: "from-amber-50 via-white to-white", ring: "ring-amber-100", shadow: "shadow-amber-100", blob: "bg-gold/20" },
        { value: "99.8%", label: "Pedidos listos a tiempo", grad: "from-emerald to-emerald/70", cardBg: "from-emerald-50 via-white to-white", ring: "ring-emerald-100", shadow: "shadow-emerald-100", blob: "bg-emerald/20" },
        { value: "+15", label: "Países en LATAM", grad: "from-sky-500 to-blue-600", cardBg: "from-sky-50 via-white to-white", ring: "ring-sky-100", shadow: "shadow-sky-100", blob: "bg-sky-400/30" },
        { value: "24/7", label: "Soporte disponible", grad: "from-purple-500 to-purple-600", cardBg: "from-purple-50 via-white to-white", ring: "ring-purple-100", shadow: "shadow-purple-100", blob: "bg-purple-400/30" },
      ].map((stat) => (
        <div class={`group relative overflow-hidden bg-gradient-to-b ${stat.cardBg} rounded-3xl p-6 sm:p-8 text-center shadow-xl ${stat.shadow} ring-1 ${stat.ring} hover:-translate-y-1 hover:shadow-2xl transition-all duration-300`}>
          <div class={`absolute -top-10 -right-10 w-28 h-28 bg-gradient-to-br ${stat.grad} opacity-10 rounded-full blur-2xl group-hover:opacity-25 transition-opacity duration-500`} aria-hidden="true"></div>
          <div class={`absolute -bottom-12 -left-12 w-32 h-32 ${stat.blob} rounded-full blur-3xl opacity-60 group-hover:opacity-100 transition-opacity duration-500`} aria-hidden="true"></div>
          <div class={`relative text-3xl sm:text-4xl font-black bg-gradient-to-br ${stat.grad} bg-clip-text text-transparent mb-2`}>{stat.value}</div>
          <div class="relative text-sm text-slate-500">{stat.label}</div>
        </div>
      ))}
    </div>

    <!-- Testimonials Carousel -->
    <div class="text-center max-w-2xl mx-auto mb-12">
      <span class="inline-flex items-center gap-2 text-gold font-bold text-sm uppercase tracking-widest">
        <span class="w-6 h-px bg-gradient-to-r from-transparent to-gold"></span>
        Testimonios
        <span class="w-6 h-px bg-gradient-to-l from-transparent to-gold"></span>
      </span>
      <h2 class="mt-5 text-3xl sm:text-4xl lg:text-5xl font-extrabold text-navy tracking-tight">
        Lo que dicen
        <span class="bg-gradient-to-r from-gold via-rose-500 to-emerald bg-clip-text text-transparent">nuestros clientes</span>
      </h2>
      <p class="mt-5 text-lg text-slate-500">
        Historias reales de personas que confiaron en nosotros para equipar su hogar.
      </p>
    </div>

    <!-- Carousel -->
    <div id="testimonial-carousel" class="relative max-w-3xl mx-auto">
      <!-- Slides container -->
      <div id="carousel-track" class="overflow-hidden" data-total={testimonials.length}>
        <div id="carousel-slides" class="flex transition-transform duration-500 ease-in-out">
          {testimonials.map((t) => (
            <div class="w-full shrink-0 px-2">
              <div class="relative overflow-hidden bg-gradient-to-b from-white via-amber-50/40 to-white rounded-[1.75rem] p-8 sm:p-10 shadow-2xl shadow-amber-100/70 ring-1 ring-amber-100 mx-auto max-w-lg">
                <div class="absolute -top-6 -right-6 w-28 h-28 bg-gradient-to-br from-amber-100 to-transparent rounded-full blur-2xl" aria-hidden="true"></div>
                <div class="absolute -bottom-10 -left-10 w-36 h-36 bg-gradient-to-tr from-emerald-100/60 to-transparent rounded-full blur-2xl" aria-hidden="true"></div>
                <div class="absolute top-6 right-6 text-gold/10" aria-hidden="true">
                  <Quote class="size-16" />
                </div>
                <div class="relative flex gap-1 mb-5">
                  {Array.from({ length: t.rating }).map(() => (
                    <Star class="size-5 text-gold fill-gold" />
                  ))}
                </div>
                <p class="relative text-slate-600 leading-relaxed mb-7">"{t.text}"</p>
                <div class="relative flex items-center gap-4 pt-5 border-t border-amber-100">
                  <div class="w-12 h-12 rounded-full bg-gradient-to-br from-gold to-gold-light flex items-center justify-center text-white font-bold text-sm shadow-lg shadow-gold/30">
                    {t.name.split(' ').map((n: string) => n[0]).join('')}
                  </div>
                  <div>
                    <div class="font-bold text-navy text-sm">{t.name}</div>
                    <div class="text-xs text-slate-400">{t.location}</div>
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Navigation arrows -->
      <button id="carousel-prev" class="absolute top-1/2 -left-4 sm:-left-8 -translate-y-1/2 w-11 h-11 sm:w-12 sm:h-12 bg-white rounded-full flex items-center justify-center text-navy hover:bg-gradient-to-r hover:from-gold hover:to-gold-light hover:text-white transition-all border border-slate-200 shadow-lg hover:shadow-gold/30" aria-label="Anterior">
        <ChevronLeft class="size-5 sm:size-6" />
      </button>
      <button id="carousel-next" class="absolute top-1/2 -right-4 sm:-right-8 -translate-y-1/2 w-11 h-11 sm:w-12 sm:h-12 bg-white rounded-full flex items-center justify-center text-navy hover:bg-gradient-to-r hover:from-gold hover:to-gold-light hover:text-white transition-all border border-slate-200 shadow-lg hover:shadow-gold/30" aria-label="Siguiente">
        <ChevronRight class="size-5 sm:size-6" />
      </button>

      <!-- Dots -->
      <div id="carousel-dots" class="flex justify-center gap-2 mt-8">
        {testimonials.map((_, i) => (
          <button
            type="button"
            data-index={i}
            class={`carousel-dot h-2.5 rounded-full transition-all ${i === 0 ? 'w-8 bg-gradient-to-r from-gold to-gold-light' : 'w-2.5 bg-slate-300 hover:bg-slate-400'}`}
            aria-label={`Ir a testimonio ${i + 1}`}
          ></button>
        ))}
      </div>
    </div>

    <!-- Security badges -->
    <div id="garantia" class="mt-24 pt-16 border-t border-slate-200/70">
      <div class="text-center max-w-2xl mx-auto mb-12">
        <h2 class="text-2xl sm:text-3xl font-extrabold text-navy tracking-tight">
          Compra con <span class="bg-gradient-to-r from-gold to-gold-light bg-clip-text text-transparent">total confianza</span>
        </h2>
        <p class="mt-4 text-slate-500">
          Tu seguridad es nuestra prioridad. Utilizamos los más altos estándares de protección.
        </p>
      </div>

      <div class="flex flex-wrap justify-center gap-6 items-center">
        {[
          { label: "SSL Encriptado", Icon: Lock, grad: "from-slate-500 to-slate-700", cardBg: "from-slate-50 via-white to-white", ring: "ring-slate-100", blob: "bg-slate-300/50" },
          { label: "Pago Seguro", Icon: Shield, grad: "from-emerald to-emerald/80", cardBg: "from-emerald-50 via-white to-white", ring: "ring-emerald-100", blob: "bg-emerald-200/50" },
          { label: "Garantía Extendida", Icon: BadgeCheck, grad: "from-gold to-gold-light", cardBg: "from-amber-50 via-white to-white", ring: "ring-amber-100", blob: "bg-gold/20" },
          { label: "Soporte 24/7", Icon: Headset, grad: "from-sky-500 to-blue-600", cardBg: "from-sky-50 via-white to-white", ring: "ring-sky-100", blob: "bg-sky-300/40" },
          { label: "Recogida Segura", Icon: Package, grad: "from-purple-500 to-purple-600", cardBg: "from-purple-50 via-white to-white", ring: "ring-purple-100", blob: "bg-purple-300/40" },
        ].map((badge) => (
          <div class={`group relative overflow-hidden flex flex-col items-center gap-3 text-center p-5 bg-gradient-to-b ${badge.cardBg} rounded-3xl shadow-lg shadow-slate-200/60 ring-1 ${badge.ring} hover:-translate-y-1 hover:shadow-xl transition-all duration-300 min-w-[9.5rem]`}>
            <div class={`absolute -top-10 -right-10 w-24 h-24 ${badge.blob} rounded-full blur-2xl opacity-60 group-hover:opacity-100 transition-opacity duration-500`} aria-hidden="true"></div>
            <div class={`relative inline-flex items-center justify-center w-12 h-12 rounded-xl bg-gradient-to-br ${badge.grad} text-white shadow-lg`}>
              <badge.Icon class="size-6" />
            </div>
            <span class="relative text-sm font-bold text-navy">{badge.label}</span>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  let autoPlayInterval: ReturnType<typeof setInterval>;
  let currentIndex = 0;

  function initCarousel() {
    const track = document.getElementById('carousel-track');
    const slides = document.getElementById('carousel-slides');
    if (!track || !slides) return;

    const dots = document.querySelectorAll('.carousel-dot');
    const prevBtn = document.getElementById('carousel-prev');
    const nextBtn = document.getElementById('carousel-next');
    const totalSlides = parseInt(track.getAttribute('data-total') || '1');

    function goToSlide(index: number) {
      currentIndex = (index + totalSlides) % totalSlides;
      slides!.style.transform = `translateX(-${currentIndex * 100}%)`;
      dots.forEach((dot, i) => {
        (dot as HTMLElement).className = i === currentIndex
          ? 'carousel-dot h-2.5 rounded-full transition-all w-8 bg-gradient-to-r from-gold to-gold-light'
          : 'carousel-dot h-2.5 rounded-full transition-all w-2.5 bg-slate-300 hover:bg-slate-400';
      });
    }

    function startAutoPlay() {
      stopAutoPlay();
      autoPlayInterval = setInterval(() => goToSlide(currentIndex + 1), 4000);
    }

    function stopAutoPlay() {
      clearInterval(autoPlayInterval);
    }

    // Reset to first slide
    currentIndex = 0;
    goToSlide(0);
    startAutoPlay();

    track.addEventListener('mouseenter', stopAutoPlay);
    track.addEventListener('mouseleave', startAutoPlay);

    prevBtn?.addEventListener('click', () => { goToSlide(currentIndex - 1); startAutoPlay(); });
    nextBtn?.addEventListener('click', () => { goToSlide(currentIndex + 1); startAutoPlay(); });

    dots.forEach(dot => {
      dot.addEventListener('click', () => {
        const index = parseInt((dot as HTMLElement).getAttribute('data-index') || '0');
        goToSlide(index);
        startAutoPlay();
      });
    });

    let touchStartX = 0;
    track.addEventListener('touchstart', (e) => {
      touchStartX = (e as TouchEvent).changedTouches[0].screenX;
      stopAutoPlay();
    });
    track.addEventListener('touchend', (e) => {
      const touchEndX = (e as TouchEvent).changedTouches[0].screenX;
      if (touchStartX - touchEndX > 50) goToSlide(currentIndex + 1);
      if (touchEndX - touchStartX > 50) goToSlide(currentIndex - 1);
      startAutoPlay();
    });
  }

  function cleanupCarousel() {
    clearInterval(autoPlayInterval);
  }

  document.addEventListener('astro:page-load', initCarousel);
  document.addEventListener('astro:before-swap', cleanupCarousel);
</script>
