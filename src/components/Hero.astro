---
import { WashingMachine, LampCeiling, Hammer, ArrowRight } from "@lucide/astro";
---
<section class="relative min-h-screen flex items-center bg-navy overflow-hidden pt-20">
  <div class="absolute inset-0 overflow-hidden pointer-events-none">
    <div class="absolute -top-40 -right-40 w-[600px] h-[600px] bg-gold/10 rounded-full blur-3xl"></div>
    <div class="absolute -bottom-40 -left-40 w-[500px] h-[500px] bg-emerald/10 rounded-full blur-3xl"></div>
  </div>

  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 lg:py-32">
    <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
      <div class="space-y-8">
        <div class="inline-flex items-center gap-2 px-4 py-2 bg-white/5 rounded-full border border-white/10">
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald"></span>
          </span>
          <span class="text-xs font-medium text-slate-300">Envíos a toda Latinoamérica</span>
        </div>

        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold text-white leading-[1.1] tracking-tight">
          Todo para tu hogar,
          <span class="block text-gold-light">al alcance de tu mano.</span>
        </h1>

        <p class="text-lg sm:text-xl text-slate-400 leading-relaxed max-w-lg">
          Electrodomésticos, accesorios y materiales de construcción para el hogar. 
          Productos de calidad con condiciones de pago que se adaptan a ti.
        </p>

        <div class="flex flex-col sm:flex-row gap-4">
          <a
            href="#catalogo"
            class="inline-flex justify-center items-center px-8 py-4 bg-gold text-white font-bold text-base rounded-full hover:bg-gold-light transition-all duration-200 shadow-xl shadow-gold/30 hover:shadow-2xl hover:shadow-gold/40 hover:-translate-y-0.5"
          >
            Ver Categorías
            <ArrowRight class="ml-2 size-5" />
          </a>
          <a
            href="/contacto"
            class="inline-flex justify-center items-center px-8 py-4 border-2 border-white/20 text-white font-semibold text-base rounded-full hover:bg-white/10 hover:border-white/30 transition-all duration-200"
          >
            Solicitar Información
          </a>
        </div>

        <div class="flex flex-wrap gap-6 pt-4">
          <div>
            <div class="text-2xl font-bold text-white">+50K</div>
            <div class="text-sm text-slate-400">Clientes satisfechos</div>
          </div>
          <div class="w-px bg-white/10 hidden sm:block"></div>
          <div>
            <div class="text-2xl font-bold text-white">99%</div>
            <div class="text-sm text-slate-400">Entregas a tiempo</div>
          </div>
          <div class="w-px bg-white/10 hidden sm:block"></div>
          <div>
            <div class="text-2xl font-bold text-white">+15</div>
            <div class="text-sm text-slate-400">Países en LATAM</div>
          </div>
        </div>
      </div>

      <!-- Category cards visual -->
      <div class="relative">
        <div class="relative bg-gradient-to-br from-navy-light to-navy rounded-3xl p-6 sm:p-8 border border-white/10 shadow-2xl">
          <div class="space-y-4">
            {[
              { name: "Electrodomésticos", desc: "Lavadoras, neveras, cocinas y más", Icon: WashingMachine },
              { name: "Accesorios del Hogar", desc: "Iluminación, decoración y menaje", Icon: LampCeiling },
              { name: "Materiales de Construcción", desc: "Herramientas, ferretería y acabados", Icon: Hammer },
            ].map((cat) => (
              <div class="bg-navy/60 rounded-2xl p-5 border border-white/5 hover:border-gold/30 transition-all duration-300 group cursor-pointer flex items-center gap-5">
                <div class="shrink-0 w-14 h-14 bg-gradient-to-br from-slate-700 to-slate-800 rounded-xl flex items-center justify-center">
                  <cat.Icon class="size-7 text-slate-400 group-hover:text-gold-light transition-colors" />
                </div>
                <div>
                  <div class="text-base font-bold text-white group-hover:text-gold-light transition-colors">{cat.name}</div>
                  <div class="text-sm text-slate-400 mt-0.5">{cat.desc}</div>
                </div>
              </div>
            ))}
          </div>
        </div>
        <!-- Floating badge -->
        <div class="absolute -bottom-4 -left-4 bg-surface rounded-2xl px-5 py-3 shadow-xl border border-slate-200 flex items-center gap-3">
          <div class="flex -space-x-2">
            <div class="w-8 h-8 rounded-full bg-gold flex items-center justify-center text-xs font-bold text-white border-2 border-surface">JD</div>
            <div class="w-8 h-8 rounded-full bg-emerald flex items-center justify-center text-xs font-bold text-white border-2 border-surface">MA</div>
            <div class="w-8 h-8 rounded-full bg-slate-500 flex items-center justify-center text-xs font-bold text-white border-2 border-surface">+</div>
          </div>
          <div>
            <div class="text-xs text-slate-500">Únete a miles</div>
            <div class="text-sm font-bold text-navy">Compradores activos</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

