<section id="calculadora" class="relative overflow-hidden bg-slate-50 py-20 lg:py-28">
  <div class="absolute inset-0 pointer-events-none">
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[800px] h-[400px] bg-gradient-to-b from-white to-transparent rounded-full blur-3xl"></div>
    <div class="absolute -top-20 -right-20 w-[400px] h-[400px] bg-gradient-to-bl from-gold/15 to-transparent rounded-full blur-3xl"></div>
  </div>

  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-2xl mx-auto mb-16">
      <span class="inline-flex items-center gap-2 text-gold font-bold text-sm uppercase tracking-widest">
        <span class="w-6 h-px bg-gradient-to-r from-transparent to-gold"></span>
        Calculadora de Cuotas
        <span class="w-6 h-px bg-gradient-to-l from-transparent to-gold"></span>
      </span>
      <h2 class="mt-5 text-3xl sm:text-4xl lg:text-5xl font-extrabold text-navy tracking-tight">
        Simula tu <span class="bg-gradient-to-r from-gold to-gold-light bg-clip-text text-transparent">plan de pago</span>
      </h2>
      <p class="mt-5 text-lg text-slate-500">
        Ajusta el monto y el plazo para ver cuánto pagarías por mes. Sin letra chica.
      </p>
    </div>

    <div class="max-w-2xl mx-auto">
      <div class="bg-white rounded-[2rem] p-8 sm:p-10 shadow-2xl shadow-slate-200/80 ring-1 ring-slate-100">
        <!-- Amount slider -->
        <div class="mb-8">
          <div class="flex justify-between items-center mb-3">
            <label class="text-sm font-bold text-navy">Monto de compra</label>
            <span id="amount-display" class="text-2xl font-black text-navy">$500.00</span>
          </div>
          <input
            type="range"
            id="amount-slider"
            min="100"
            max="5000"
            step="50"
            value="500"
            class="w-full h-2.5 bg-gradient-to-r from-slate-200 to-slate-300 rounded-full appearance-none cursor-pointer
              [&::-webkit-slider-thumb]:appearance-none [&::-webkit-slider-thumb]:w-6 [&::-webkit-slider-thumb]:h-6 [&::-webkit-slider-thumb]:rounded-full [&::-webkit-slider-thumb]:bg-gradient-to-br [&::-webkit-slider-thumb]:from-gold [&::-webkit-slider-thumb]:to-gold-light [&::-webkit-slider-thumb]:shadow-lg [&::-webkit-slider-thumb]:shadow-gold/40 [&::-webkit-slider-thumb]:cursor-pointer [&::-webkit-slider-thumb]:ring-4 [&::-webkit-slider-thumb]:ring-white"
          />
          <div class="flex justify-between mt-2 text-xs text-slate-400">
            <span>$100</span>
            <span>$5,000</span>
          </div>
        </div>

        <!-- Installments selector -->
        <div class="mb-8">
          <label class="text-sm font-bold text-navy block mb-3">Plazo en cuotas</label>
          <div class="grid grid-cols-4 gap-3" id="cuotas-group">
            {[3, 6, 12, 24].map((n) => (
              <button
                type="button"
                data-cuotas={n}
                class={`cuota-btn py-3 px-2 rounded-2xl text-sm font-bold border transition-all duration-200 ${
                  n === 12
                    ? "bg-gradient-to-r from-gold to-gold-light text-white border-transparent shadow-lg shadow-gold/30"
                    : "bg-white text-slate-500 border-slate-200 hover:border-gold hover:text-gold"
                }`}
              >
                {n} cuotas
              </button>
            ))}
          </div>
        </div>

        <!-- Result -->
        <div class="bg-gradient-to-br from-navy to-navy-light rounded-3xl p-7 shadow-xl shadow-navy/20">
          <div class="text-center">
            <div class="text-sm text-slate-400 mb-1">Pagarías aproximadamente</div>
            <div id="monthly-payment" class="text-4xl sm:text-5xl font-black bg-gradient-to-r from-gold to-gold-light bg-clip-text text-transparent">$41.67</div>
            <div class="text-sm text-slate-400 mt-1">por mes durante <span id="months-display" class="font-semibold text-white">12</span> meses</div>
          </div>

          <div class="mt-6 pt-6 border-t border-white/10 grid grid-cols-3 gap-4 text-center">
            <div>
              <div class="text-xs text-slate-500 mb-1">Total a pagar</div>
              <div id="total-price" class="text-lg font-bold text-white">$500.00</div>
            </div>
            <div>
              <div class="text-xs text-slate-500 mb-1">Interés</div>
              <div class="text-lg font-bold text-emerald">0%</div>
            </div>
            <div>
              <div class="text-xs text-slate-500 mb-1">Ahorro vs retail</div>
              <div id="savings" class="text-lg font-bold text-gold-light">$150.00</div>
            </div>
          </div>
        </div>

        <a
          href="#catalogo"
          class="mt-6 inline-flex w-full justify-center items-center px-8 py-4 bg-gradient-to-r from-gold to-gold-light text-white font-bold text-base rounded-2xl hover:from-gold-light hover:to-gold transition-all duration-200 shadow-xl shadow-gold/30"
        >
          Quiero empezar a comprar
        </a>
      </div>
    </div>
  </div>
</section>

<script>
  const amountSlider = document.getElementById('amount-slider') as HTMLInputElement;
  const amountDisplay = document.getElementById('amount-display');
  const monthlyPayment = document.getElementById('monthly-payment');
  const monthsDisplay = document.getElementById('months-display');
  const totalPrice = document.getElementById('total-price');
  const savings = document.getElementById('savings');
  const cuotaBtns = document.querySelectorAll('.cuota-btn');

  let selectedCuotas = 12;

  function updateDisplay() {
    const amount = parseFloat(amountSlider.value);
    const monthly = amount / selectedCuotas;
    const savedAmount = amount * 0.3;

    if (amountDisplay) amountDisplay.textContent = `$${amount.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
    if (monthlyPayment) monthlyPayment.textContent = `$${monthly.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
    if (monthsDisplay) monthsDisplay.textContent = selectedCuotas.toString();
    if (totalPrice) totalPrice.textContent = `$${amount.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
    if (savings) savings.textContent = `$${savedAmount.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
  }

  amountSlider?.addEventListener('input', updateDisplay);

  cuotaBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      selectedCuotas = parseInt(btn.getAttribute('data-cuotas') || '12');
      cuotaBtns.forEach(b => {
        b.className = b.className.replace(/bg-gradient-to-r from-gold to-gold-light text-white border-transparent shadow-lg shadow-gold\/30/, '')
          .replace(/bg-white text-slate-500 border-slate-200 hover:border-gold hover:text-gold/, '');
        b.classList.add('bg-white', 'text-slate-500', 'border-slate-200');
      });
      btn.className = 'cuota-btn py-3 px-2 rounded-2xl text-sm font-bold border transition-all duration-200 bg-gradient-to-r from-gold to-gold-light text-white border-transparent shadow-lg shadow-gold/30';
      updateDisplay();
    });
  });
</script>
